+# Pin the rule set explicitly rather than inheriting ruff's defaults. Those
+# defaults expand between releases — 0.16 added rules 0.15 didn't have — so an
+# unpinned `pip install ruff` in CI is a build that can go red without anyone
+# touching the code. Name what we lint for, and it behaves the same everywhere.
+[tool.ruff.lint]
+select = [
+    "E",   # pycodestyle errors
+    "F",   # pyflakes
+    "W",   # pycodestyle warnings
