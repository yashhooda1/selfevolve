--- /dev/null
+++ b/verify.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# Rerun everything in this folder, from a clean slate.
+#
+#   ./verify.sh          install, test, prove offline, run a demo loop
+#   ./verify.sh --keep   same, but don't wipe rules learned so far
+#
+# Uses `python -m selfevolve.cli` rather than the `selfevolve` command, so it
+# works whether or not Python's scripts directory is on your PATH.
+
+set -euo pipefail
+cd "$(dirname "$0")"
+
+KEEP=0
+[ "${1:-}" = "--keep" ] && KEEP=1
+
+PY="${PYTHON:-python3}"
+command -v "$PY" >/dev/null 2>&1 || PY=python
+
+# Keep the demo's learned rules out of your real store.
+export SELFEVOLVE_DATA_DIR="${SELFEVOLVE_DATA_DIR:-$PWD/.selfevolve}"
+
+hr() { printf '============================================================\n'; }
+
+hr
+echo "  selfevolve : full rerun"
+echo "  folder  $PWD"
+echo "  store   $SELFEVOLVE_DATA_DIR"
+hr
+
+echo; echo "[1/6] Installing (editable)"
+"$PY" -m pip install -e ".[all]" --quiet
+
+echo; echo "[2/6] Running the test suite"
+"$PY" -m pytest tests -q
+
+echo; echo "[3/6] Linting"
+"$PY" -m ruff check .
+
+echo; echo "[4/6] Proving it runs with the network cut"
+"$PY" -m selfevolve.cli doctor
+
+if [ "$KEEP" = "1" ]; then
+  echo; echo "[5/6] Keeping existing rules (--keep)"
+else
+  echo; echo "[5/6] Clearing learned rules for a clean demo"
+  "$PY" -m selfevolve.cli reset --yes
+fi
+
+echo; echo "[6/6] Demo: teach it once, watch it apply the lesson"
+echo; echo "--- review 1: pipeline.py, rejecting the docstring nit ---"
+printf 'a\n\nr\nour linter enforces docstrings\n' \
+  | "$PY" -m selfevolve.cli --backend fake review examples/sample_code/pipeline.py --project demo
+
+echo; echo "--- what it learned ---"
+"$PY" -m selfevolve.cli insights
+
+echo; echo "--- review 2: handlers.py, a different file ---"
+echo "(the rejected comment should not reappear)"
+printf 's\n' \
+  | "$PY" -m selfevolve.cli --backend fake review examples/sample_code/handlers.py --project demo
+
+echo; echo "--- metrics ---"
+"$PY" -m selfevolve.cli metrics
+
+echo; hr
+echo "  All green."
+echo
+echo "  Next, with a real model:"
+echo "    ollama pull qwen3:8b"
+echo "    ollama pull nomic-embed-text"
+echo "    $PY -m selfevolve.cli review path/to/your/file.py --project yourproj"
+echo
+echo "  Or the UI:  streamlit run app/streamlit_app.py"
+hr
