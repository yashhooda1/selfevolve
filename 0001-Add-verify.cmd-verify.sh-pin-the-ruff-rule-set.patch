+@echo off
+REM Rerun everything in this folder, from a clean slate.
+REM
+REM   verify.cmd          install, test, prove offline, run a demo loop
+REM   verify.cmd --keep   same, but don't wipe rules learned so far
+REM
+REM Uses `python -m selfevolve.cli` rather than the `selfevolve` command, so it
+REM works whether or not Python's Scripts directory is on your PATH.
+
+setlocal enabledelayedexpansion
+cd /d "%~dp0"
+
+set "KEEP=0"
+if /i "%~1"=="--keep" set "KEEP=1"
+
+REM Keep the demo's learned rules out of your real store.
+if not defined SELFEVOLVE_DATA_DIR set "SELFEVOLVE_DATA_DIR=%~dp0.selfevolve"
+
+echo.
+echo ============================================================
+echo   selfevolve : full rerun
+echo   folder  %CD%
+echo   store   %SELFEVOLVE_DATA_DIR%
+echo ============================================================
+
+echo.
+echo [1/6] Installing (editable)
+python -m pip install -e ".[all]" --quiet || goto :fail
+
+echo.
+echo [2/6] Running the test suite
+python -m pytest tests -q || goto :fail
+
+echo.
+echo [3/6] Linting
+python -m ruff check . || goto :fail
+
+echo.
+echo [4/6] Proving it runs with the network cut
+python -m selfevolve.cli doctor || goto :fail
+
+if "%KEEP%"=="1" (
+  echo.
+  echo [5/6] Keeping existing rules ^(--keep^)
+) else (
+  echo.
+  echo [5/6] Clearing learned rules for a clean demo
+  python -m selfevolve.cli reset --yes || goto :fail
+)
+
+echo.
+echo [6/6] Demo: teach it once, watch it apply the lesson
+echo.
+echo --- review 1: pipeline.py, rejecting the docstring nit ---
+(echo a& echo.& echo r& echo our linter enforces docstrings) | python -m selfevolve.cli --backend fake review examples\sample_code\pipeline.py --project demo
+
+echo.
+echo --- what it learned ---
+python -m selfevolve.cli insights
+
+echo.
+echo --- review 2: handlers.py, a different file ---
+echo (the rejected comment should not reappear)
+(echo s) | python -m selfevolve.cli --backend fake review examples\sample_code\handlers.py --project demo
+
+echo.
+echo --- metrics ---
+python -m selfevolve.cli metrics
+
+echo.
+echo ============================================================
+echo   All green.
+echo.
+echo   Next, with a real model:
+echo     ollama pull qwen3:8b
+echo     ollama pull nomic-embed-text
+echo     python -m selfevolve.cli review path\to\your\file.py --project yourproj
+echo.
+echo   Or the UI:  streamlit run app\streamlit_app.py
+echo ============================================================
+echo.
+endlocal
+exit /b 0
+
+:fail
+echo.
+echo ============================================================
+echo   FAILED at the step above. Nothing below it ran.
+echo ============================================================
+endlocal
+exit /b 1
