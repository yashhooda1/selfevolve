# Copy to .env and adjust. Every value is optional; every default is local.

SELFEVOLVE_LLM_BACKEND=ollama          # ollama | fake
SELFEVOLVE_LLM_MODEL=qwen3:8b
SELFEVOLVE_EMBED_BACKEND=auto          # auto | ollama | hash
SELFEVOLVE_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434     # doctor warns if this is not loopback

SELFEVOLVE_DATA_DIR=./.selfevolve
SELFEVOLVE_TOP_K_INSIGHTS=6
SELFEVOLVE_TOP_K_TRAJECTORIES=2
SELFEVOLVE_MIN_CONFIDENCE=0.25
SELFEVOLVE_RETIRE_BELOW=0.15
SELFEVOLVE_LLM_TIMEOUT=180
